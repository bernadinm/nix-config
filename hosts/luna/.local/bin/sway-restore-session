#!/usr/bin/env bash
# Sway session restorer with workspace positioning

SWAYSOCK=$(ls /run/user/$(id -u)/sway-ipc.*.sock 2>/dev/null | head -1)
export SWAYSOCK
SESSION_FILE=~/.local/share/sway-session.json

if [[ ! -f "$SESSION_FILE" ]]; then
    echo "No session file found"
    exit 0
fi

# Map app_id to launch commands
declare -A APP_COMMANDS=(
    ["Alacritty"]="alacritty"
    ["alacritty"]="alacritty"
    ["firefox"]="firefox"
    ["brave-browser"]="brave"
    ["Logseq"]="logseq"
    ["org.gnome.Nautilus"]="nautilus"
    ["code"]="code"
    ["Code"]="code"
    ["Slack"]="slack"
    ["discord"]="discord"
    ["spotify"]="spotify"
    ["Spotify"]="spotify"
    ["obsidian"]="obsidian"
    ["Rustdesk"]="rustdesk"
)

# Read saved session and launch apps on their workspaces
jq -r '.[] | "\(.app_id)|\(.workspace)"' "$SESSION_FILE" | while IFS='|' read app_id workspace; do
    cmd="${APP_COMMANDS[$app_id]}"
    if [[ -n "$cmd" ]]; then
        echo "Launching $cmd on workspace $workspace"
        # Switch to target workspace, launch app, then it opens there
        swaymsg "workspace $workspace; exec $cmd"
        sleep 0.5
    fi
done

# Return to workspace 1
swaymsg "workspace 1"

echo "Session restored"
