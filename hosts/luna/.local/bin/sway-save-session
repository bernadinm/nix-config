#!/usr/bin/env bash
# Sway session saver with workspace tracking

SWAYSOCK=$(ls /run/user/$(id -u)/sway-ipc.*.sock 2>/dev/null | head -1)
export SWAYSOCK
SESSION_FILE=~/.local/share/sway-session.json

mkdir -p ~/.local/share

# Save windows with their workspace
swaymsg -t get_tree | jq '
  [
    .nodes[] | select(.type == "output") |
    .nodes[] | select(.type == "workspace") |
    . as $ws |
    (recurse(.nodes[]?, .floating_nodes[]?) | select(.type == "con" and .pid > 0)) |
    {
      app_id: (.app_id // .window_properties.class // "unknown"),
      workspace: $ws.name,
      pid: .pid
    }
  ] | unique_by(.app_id)
' > "$SESSION_FILE"

echo "Session saved to $SESSION_FILE"
cat "$SESSION_FILE"
